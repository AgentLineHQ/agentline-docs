{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AgentLine",
  "description": "Phone numbers, voice, and SMS for AI agents. Documentation, SDKs, and API reference.",
  "colors": {
    "primary": "#DC2626"
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "javascript"],
      "autogenerate": true
    },
    "params": {
      "expanded": "closed"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["introduction", "quickstart", "authentication"]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/agents",
              "guides/numbers",
              "guides/calls",
              "guides/messages",
              "guides/events",
              "guides/webhooks"
            ]
          },
          {
            "group": "SDKs",
            "pages": ["sdk/python", "sdk/node"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.json"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://agentline.ai",
      "github": "https://github.com/AgentLineHQ"
    },
    "links": [
      {
        "header": "Docs",
        "items": [
          { "label": "Introduction", "href": "/introduction" },
          { "label": "Quickstart", "href": "/quickstart" },
          { "label": "Authentication", "href": "/authentication" }
        ]
      },
      {
        "header": "SDKs",
        "items": [
          { "label": "Python", "href": "/sdk/python" },
          { "label": "Node", "href": "/sdk/node" }
        ]
      },
      {
        "header": "More",
        "items": [
          { "label": "API Reference", "href": "/api-reference" },
          { "label": "Support", "href": "mailto:support@agentline.ai" }
        ]
      }
    ]
  }
}
