{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AgentLine",
  "description": "Phone numbers, voice, and SMS for AI agents. Documentation, SDKs, and API reference.",
  "colors": {
    "primary": "#DC2626",
    "light": "#F87171",
    "dark": "#B91C1C"
  },
  "favicon": "/images/favicon.png",
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "https://agentline.cloud"
  },
  "navbar": {
    "links": [
      { "type": "discord", "href": "https://discord.gg/69SVE2jWNr" },
      { "label": "Support", "href": "mailto:support@agentline.cloud", "icon": "envelope", "iconType": "solid" }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://agentline.cloud/signup"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "javascript"],
      "autogenerate": true
    },
    "params": {
      "expanded": "closed"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["introduction", "quickstart", "authentication"]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/agents",
              "guides/numbers",
              "guides/calls",
              "guides/messages",
              "guides/events",
              "guides/webhooks"
            ]
          },
          {
            "group": "SDKs",
            "pages": ["sdk/python", "sdk/node"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.json"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://agentline.cloud",
      "github": "https://github.com/AgentLineHQ",
      "discord": "https://discord.gg/69SVE2jWNr"
    },
    "links": [
      {
        "header": "Docs",
        "items": [
          { "label": "Introduction", "href": "/introduction" },
          { "label": "Quickstart", "href": "/quickstart" },
          { "label": "Authentication", "href": "/authentication" }
        ]
      },
      {
        "header": "SDKs",
        "items": [
          { "label": "Python", "href": "/sdk/python" },
          { "label": "Node", "href": "/sdk/node" }
        ]
      },
      {
        "header": "More",
        "items": [
          { "label": "API Reference", "href": "/api-reference" },
          { "label": "Support", "href": "mailto:support@agentline.cloud" }
        ]
      }
    ]
  }
}
